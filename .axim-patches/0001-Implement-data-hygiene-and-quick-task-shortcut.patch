+export const findDuplicates = (contacts) => {
+  if (!contacts || contacts.length === 0) return [];
+
+  const duplicates = [];
+  const seen = new Set();
+  const duplicateIds = new Set();
+
+  // We need to return pairs or groups of duplicates.
+  // A simple way: find all records that share an email OR first_name + last_name
+  const emailMap = new Map();
+  const nameMap = new Map();
+
+  contacts.forEach(contact => {
+    // Check Email
+    if (contact.email) {
+      const email = contact.email.toLowerCase();
+      if (emailMap.has(email)) {
+        emailMap.get(email).push(contact);
+      } else {
+        emailMap.set(email, [contact]);
+      }
+    }
+
+    // Check Name
+    if (contact.first_name && contact.last_name) {
+      const nameKey = `${contact.first_name.toLowerCase()}|${contact.last_name.toLowerCase()}`;
+      if (nameMap.has(nameKey)) {
+        nameMap.get(nameKey).push(contact);
+      } else {
+        nameMap.set(nameKey, [contact]);
+      }
+    }
+  });
+
+  const duplicateGroups = [];
+
+  emailMap.forEach(group => {
+    if (group.length > 1) {
+      duplicateGroups.push(group);
+    }
+  });
+
+  nameMap.forEach(group => {
+    if (group.length > 1) {
+      // Check if this group is already in duplicateGroups (e.g. they share email AND name)
+      // To simplify, we can just return all groups. For the modal, we just need pairs to merge.
+      // We will just add the group if we haven't seen these exact pairs.
+      // Let's filter out groups where all members are already in another group together.
+      const isSubset = duplicateGroups.some(existingGroup => {
+        return group.every(c => existingGroup.find(ec => ec.id === c.id));
+      });
+      if (!isSubset) {
+        duplicateGroups.push(group);
+      }
+    }
+  });
+
+  return duplicateGroups;
+};
